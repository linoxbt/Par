# testnet | mainnet | local
CHAIN=testnet
RPC_URL=https://rpc.test.mezo.org
# A dedicated keeper key that only holds gas money (NOT the deployer / circle-admin key)
KEEPER_KEY=0x
FACTORY=0x
CIRCUIT=0x
# How often to scan (ms). 15000 for the demo, 60000+ in prod.
INTERVAL_MS=15000

# Alerts (health, Recovery Mode reserve, stuck jobs, low keeper balance). Logged always; also sent to:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# and/or POSTed as JSON ({kind, ...data, text}) to a webhook (Discord/Slack bridge, etc.)
ALERT_WEBHOOK_URL=
# Re-send an unresolved alert at most this often (ms)
ALERT_COOLDOWN_MS=1800000
# Alert when the keeper's own balance drops below this (BTC)
LOW_BALANCE_BTC=0.005

# Free reserved capacity by closing expired commitments (permissionless). true | false
AUTO_CLOSE_EXPIRED=true
# Per-job retries before giving up (with an alert)
MAX_RETRIES=40
# Liveness: heartbeat log interval, and max tick duration before the process exits for a restart (ms)
HEARTBEAT_MS=300000
TICK_TIMEOUT_MS=600000

# Optional hint contracts (zero hints work, cost more gas). Defaults to the official matsnet/mainnet addresses.
TROVE_MANAGER=
HINT_HELPERS=
SORTED_TROVES=
