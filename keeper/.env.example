# testnet | mainnet | local
CHAIN=testnet
RPC_URL=https://rpc.test.mezo.org
# Funded with testnet BTC for gas
KEEPER_KEY=0x
FACTORY=0x
CIRCUIT=0x
# How often to scan (ms). 15000 for the demo, 300000 in prod.
INTERVAL_MS=15000
# Health / Recovery Mode alerts are logged; set to also POST them as JSON (Telegram bridge, Slack, ...)
ALERT_WEBHOOK_URL=
# Optional hint contracts (zero hints work, cost more gas). Defaults to the official matsnet/mainnet addresses.
TROVE_MANAGER=
HINT_HELPERS=
SORTED_TROVES=
