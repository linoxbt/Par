# testnet | mainnet | local
NEXT_PUBLIC_CHAIN=testnet
NEXT_PUBLIC_FACTORY=0x
NEXT_PUBLIC_CIRCUIT=0x
NEXT_PUBLIC_MARKET=0x
NEXT_PUBLIC_FACTORY_BLOCK=0
# Reown project ID (https://cloud.reown.com). Public. Enables Reown AppKit for EVM wallets;
# Bitcoin wallets always go through Mezo Passport. Without it the app falls back to RainbowKit.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Optional overrides
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_INTEREST_RATE_MANAGER=
